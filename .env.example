# 🔧 FastAPI 서비스 환경설정 파일
#
# 이 파일은 FastAPI 애플리케이션 실행 시 필요한 환경변수를 정의합니다.
#
# [사용 위치]
# 1. 로컬 개발: services/fastapi/.env (이 파일의 복사본)
# 2. Docker Compose: infra/.env에서도 일부 변수가 공유됨
# 3. EB 배포: CI/CD가 생성한 .env 파일에서 로드됨
#
# [배포 환경별 설정]
# - 로컬 개발: 아래 값들을 로컬에 맞게 수정해서 사용
# - 배포 환경: GitHub Secrets에서 읽어서 자동 생성됨

# ═══════════════════════════════════════════════════════════════════════════
# 🔗 PostgreSQL 데이터베이스 설정
# ═══════════════════════════════════════════════════════════════════════════

# 데이터베이스 호스트
# [로컬]: localhost (로컬 PC에서 실행)
#         또는 postgres (docker-compose 컨테이너 이름)
# [배포]: 프로덕션 RDS 엔드포인트 (GitHub Secrets에서 로드)
POSTGRES_HOST=localhost

# 데이터베이스 포트 (기본값: 5432)
POSTGRES_PORT=5432

# 데이터베이스 이름
# [로컬]: 자유롭게 설정 (보통 tailtalk_db)
# [배포]: GitHub Secrets의 POSTGRES_DB 값 사용
POSTGRES_DB=tailtalk_db

# 데이터베이스 사용자명
# [로컬]: 간단한 테스트 사용자명
# [배포]: GitHub Secrets의 POSTGRES_USER 값 사용
POSTGRES_USER=mungnyang

# 데이터베이스 비밀번호
# [로컬]: 로컬에서는 보안 불필요 (빈칸)
# [배포]: GitHub Secrets의 POSTGRES_PASSWORD 값 사용 (중요!)
POSTGRES_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# 🔑 API 키 설정
# ═══════════════════════════════════════════════════════════════════════════

# OpenAI API 키 (ChatGPT, 텍스트 생성 용도)
# [로컬]: 테스트하지 않으면 비워둬도 됨
# [배포]: GitHub Secrets의 OPENAI_API_KEY 값 사용 (중요!)
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 📊 LangSmith 추적 설정 (AI 모니터링)
# ═══════════════════════════════════════════════════════════════════════════

# LangSmith 트레이싱 활성화
# [로컬]: false (로컬 개발 시 자세한 모니터링 필요 없으면 비활성화)
#         true (LangSmith 모니터링 원하면 활성화)
# [배포]: true (프로덕션에서는 모니터링 권장)
LANGSMITH_TRACING=false

# LangSmith API 키 (추적 활성화할 때 필수)
# [로컬]: 비워둬도 됨 (TRACING=false인 경우)
# [배포]: GitHub Secrets의 LANGSMITH_API_KEY 값 사용
LANGSMITH_API_KEY=

# LangSmith 프로젝트명
# [로컬]: tailtalk-fastapi-local (로컬 개발용)
# [배포]: GitHub Secrets의 LANGSMITH_PROJECT 값 사용
LANGSMITH_PROJECT=tailtalk-fastapi-local

# LangSmith API 엔드포인트
# [로컬, 배포 공통]: https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith 워크스페이스 ID
# [로컬]: 비워둬도 됨 (TRACING=false인 경우)
# [배포]: GitHub Secrets의 LANGSMITH_WORKSPACE_ID 값 사용
LANGSMITH_WORKSPACE_ID=
