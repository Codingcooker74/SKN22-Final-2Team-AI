## Elastic Beanstalk Docker Hub Registry Authentication Configuration
##
## EB 인스턴스가 docker-compose 실행 전에 Docker Hub에 인증
## - docker-compose 실행 전에 docker login 완료해야 함
## - .ebextensions는 docker-compose 실행 전에 처리됨

commands:
  01_docker_login:
    command: |
      set -e
      
      # /var/app/current에서 .env 파일 읽어서 Docker Hub 자격증명 로드
      if [ -f /var/app/current/.env ]; then
        export $(grep -v '^#' /var/app/current/.env | xargs)
      fi
      
      # 자격증명이 존재하면 docker login 실행
      if [ -n "$DOCKER_USERNAME" ] && [ -n "$DOCKER_PASSWORD" ]; then
        echo "Attempting Docker Hub login..."
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
        echo "Docker Hub login successful"
      else
        echo "Warning: Docker credentials not found - image must be public or already cached"
      fi
    ignoreErrors: true
    leader_only: true
