## Elastic Beanstalk Docker Hub Registry Authentication Configuration
##
## EB 인스턴스가 docker-compose 실행 시 Docker Hub private image를 pull할 수 있도록 설정
## - EC2 인스턴스의 /root/.docker/config.json에 인증 정보 작성
## - docker-compose.yml의 auth 속성과 함께 작동

commands:
  01_create_docker_dir:
    command: |
      mkdir -p /root/.docker
    ignoreErrors: true

container_commands:
  01_docker_login:
    command: |
      set -e
      
      # 환경변수에서 Docker Hub 자격증명 읽기
      DOCKER_USERNAME="${DOCKER_USERNAME}"
      DOCKER_PASSWORD="${DOCKER_PASSWORD}"
      
      # 자격증명이 존재하면 docker login 실행
      if [ -n "$DOCKER_USERNAME" ] && [ -n "$DOCKER_PASSWORD" ]; then
        echo "Logging in to Docker Hub..."
        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
      else
        echo "Warning: Docker credentials not found in environment variables"
      fi
    leader_only: true
    ignoreErrors: true
