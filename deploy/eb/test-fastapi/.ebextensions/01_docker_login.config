## Elastic Beanstalk Docker Hub Registry Authentication Configuration
##
## EB 환경변수에서 Docker Hub 자격증명을 읽고 docker login 실행
## - eb setenv로 DOCKER_USERNAME, DOCKER_PASSWORD 설정됨
## - container_commands에서 환경변수 직접 접근 가능

container_commands:
  01_docker_login:
    command: |
      set -e
      
      # EB 환경변수에서 Docker Hub 자격증명 읽기
      if [ -n "${DOCKER_USERNAME}" ] && [ -n "${DOCKER_PASSWORD}" ]; then
        echo "Attempting Docker Hub login..."
        echo "${DOCKER_PASSWORD}" | docker login -u "${DOCKER_USERNAME}" --password-stdin
        echo "Docker Hub login successful"
      else
        echo "ERROR: Docker credentials not found in EB environment variables"
        exit 1
      fi
    ignoreErrors: false
    leader_only: true

